#include <iostream>

using namespace std;

struct Edge {
    int u, v, w;
};

void bellmanFord(Edge edges[], int V, int E, int src) {
    int dist[100];

    // Initialize all distances to a large number directly
    for (int i = 0; i < V; i++) dist[i] = 999999;
    dist[src] = 0;

    for (int i = 1; i <= V - 1; i++) {
        for (int j = 0; j < E; j++) {
            int u = edges[j].u;
            int v = edges[j].v;
            int w = edges[j].w;
            if (dist[u] + w < dist[v]) {
                dist[v] = dist[u] + w;
            }
        }
    }

    cout << "Node\tDistance\n";
    for (int i = 0; i < V; i++) {
        cout << i << "\t" << dist[i] << endl;
    }
}

int main() {
    int V = 5, E = 8;
    Edge edges[] = {
        {0, 1, -1}, {0, 2, 4}, {1, 2, 3}, {1, 3, 2},
        {1, 4, 2},  {3, 2, 5}, {3, 1, 1}, {4, 3, -3}
    };

    bellmanFord(edges, V, E, 0);
    return 0;
}
