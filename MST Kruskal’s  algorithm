#include <iostream>

using namespace std;

struct Edge {
    int u, v, w;
};

int parent[100];

int findSet(int i) {
    if (parent[i] == i) return i;
    return parent[i] = findSet(parent[i]);
}

void sortEdges(Edge edges[], int numEdges) {
    for (int i = 0; i < numEdges - 1; i++) {
        for (int j = 0; j < numEdges - i - 1; j++) {
            if (edges[j].w > edges[j + 1].w) {
                Edge temp = edges[j];
                edges[j] = edges[j + 1];
                edges[j + 1] = temp;
            }
        }
    }
}

void kruskal(Edge edges[], int V, int E) {
    for (int i = 0; i < V; i++) parent[i] = i;

    sortEdges(edges, E);

    int mstWeight = 0;
    cout << "Edges in MST:\n";

    for (int i = 0; i < E; i++) {
        int rootU = findSet(edges[i].u);
        int rootV = findSet(edges[i].v);

        if (rootU != rootV) {
            cout << edges[i].u << " - " << edges[i].v << " : " << edges[i].w << endl;
            mstWeight += edges[i].w;
            parent[rootU] = rootV;
        }
    }
    cout << "Total Weight: " << mstWeight << endl;
}

int main() {
    int V = 4, E = 5;
    Edge edges[] = {
        {0, 1, 10},
        {0, 2, 6},
        {0, 3, 5},
        {1, 3, 15},
        {2, 3, 4}
    };

    kruskal(edges, V, E);
    return 0;
}
